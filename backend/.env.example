# Server Configuration
PORT=5000
NODE_ENV=development
PUBLIC_API_URL="http://localhost:5000"

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/stren_db?schema=public"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# Frontend Client URL (for CORS and Socket.IO)
CLIENT_URL="http://localhost:5173"

# Persistent Image Storage Configuration
# Set STORAGE_PROVIDER to "cloudinary" (recommended) or "supabase".
# In development, if cloud credentials are not yet set, uploads fall back to local persistent storage (/uploads/exercises).
STORAGE_PROVIDER="cloudinary"

# Cloudinary Configuration (Required when STORAGE_PROVIDER="cloudinary" in production)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_FOLDER="stren/exercises"

# Supabase Storage Configuration (Optional alternative when STORAGE_PROVIDER="supabase")
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="exercises"

# Email Delivery Configuration
# Supported providers: "console" (default for dev/test) | "smtp" | "resend"
EMAIL_PROVIDER="console"
EMAIL_FROM="STREN <no-reply@stren.app>"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
RESEND_API_KEY="re_your_resend_api_key"

# Google OAuth 2.0 Web Application Credentials
# Backend requires GOOGLE_CLIENT_ID to verify ID tokens from Google Identity Services
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

