# STREN Frontend Environment Configuration
# Backend API Base URL
# - Production (Render): https://gym-managment-platform.onrender.com (or https://gym-managment-platform.onrender.com/api/v1)
# - Local development: http://localhost:5000/api/v1
# Note: The frontend API client automatically normalizes host URLs to include the required /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Google OAuth 2.0 Web Application Client ID
# Must match GOOGLE_CLIENT_ID in backend/.env
# Note: Never provide Google Client Secret to the frontend
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
